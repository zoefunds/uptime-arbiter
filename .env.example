# Uptime Arbiter — root env template. Copy to .env and fill in real values.
# NEVER commit the filled-in .env — it's gitignored on purpose.

# Reown (WalletConnect) AppKit project id — https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Redis — backend rate limiting against StudioNet's real 500 req/hour ceiling
REDIS_URL=

# Canonical public deployment, verified 15 October 2026. Keep frontend and
# backend builds on this exact pair; contract-local SLA IDs are not portable.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x700D935A78562Dd5FBdfA603bbb5E00C9f521D81
NEXT_PUBLIC_BASE_ESCROW_ADDRESS=0x9d8A7e19336725E261d2e11aB4171F1748aB0d6d
NEXT_PUBLIC_BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
GENLAYER_STUDIONET_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_NETWORK_ALIAS=studionet

# Backend-only — see backend/.env.example for the full backend env
DATABASE_URL=
JWT_SIGNING_SECRET=
BASE_RELAYER_PRIVATE_KEY=
# Separately held backend-only roles for authenticated disputed-ruling review.
# The escrow requires owner, relayer, resolver, and verifier to be different.
BASE_DISPUTE_RESOLVER_PRIVATE_KEY=
BASE_RULING_VERIFIER_PRIVATE_KEY=
